{
  "name": "ona-live-studio",
  "version": "0.2.0",
  "description": "Motor de mezcla digital profesional para presentaciones en vivo",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run vite\" \"npm run electron\"",
    "vite": "vite",
    "electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build && electron-builder",
    "server": "node src/server/index.js",
    "build:native": "cd native && napi build --platform --release --js false --dts false",
    "build:native:debug": "cd native && napi build --platform --js false --dts false",
    "rebuild:native": "cd native && napi build --platform --release --js false --dts false"
  },
  "dependencies": {
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.6.1",
    "socket.io-client": "^4.8.3",
    "tone": "^14.7.77",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  }
}
